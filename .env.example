POSTGRES_PASSWORD=replace-with-a-local-password
# Tối đa 28: Binance chỉ giữ ~30 ngày open interest / long-short ratio, nên lấy hết khi khởi tạo.
BACKFILL_DAYS=28
LOOKBACK=60
POLL_SECONDS=60

# Chiến lược H1 (touch + hướng B) - worker strategy-h1
#   Bundle tạo bởi model_training/train_strategy_h1.ipynb (st.export_bundle)
STRATEGY_BUNDLE=artifacts/1h_strategy_v1/models_final.joblib
#   Số ngày nến dùng để tính feature (>= 180 để xác suất trùng backtest)
STRATEGY_HISTORY_DAYS=200
#   Chờ dữ liệu vị thế (OI, long/short, premium) của nến 5m cuối giờ tối đa bao nhiêu giây
STRATEGY_MAX_WAIT_S=600
#   Khi khởi động lại: tính bù tín hiệu cho tối đa N giờ đã qua (không vào lệnh nếu trễ > STRATEGY_MAX_ENTRY_DELAY_MIN)
STRATEGY_CATCHUP_HOURS=6
STRATEGY_MAX_ENTRY_DELAY_MIN=10
#   Giá vào lệnh paper: next_1m = open nến 1m đầu tiên sau lúc ra quyết định (thực tế);
#                       bar_open = open nến 5m đầu giờ (đúng như backtest)
STRATEGY_ENTRY=next_1m
STRATEGY_START_EQUITY=1.0
#   create_time (data.binance.vision, dùng khi train) = timestamp REST + giá trị này.
#   Kiểm tra bằng: docker compose run --rm cli python -m pipeline check-positioning
POSITIONING_TS_SHIFT_MS=0

# Telegram bot (tạo bot với @BotFather). Lấy chat id bằng:
#   docker compose run --rm telegram python -m pipeline telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SOURCE=strategy_h1
TELEGRAM_HEALTH_SERVICE=strategy-h1
# Báo cả tín hiệu bị bỏ qua (đã đủ 5 lệnh, ra quá trễ)
TELEGRAM_NOTIFY_SKIPPED=true
TELEGRAM_UTC_OFFSET_HOURS=7
# Giờ gửi tổng kết hằng ngày (giờ địa phương), -1 để tắt
TELEGRAM_DAILY_HOUR=8

# Trang công khai (worker public-site): kết quả theo % tài khoản, cập nhật mỗi PUBLIC_INTERVAL_S giây.
#   Luôn ghi artifacts/public/index.html + data.json. Nếu đặt PUBLIC_GITHUB_REPO + PUBLIC_GITHUB_TOKEN thì đẩy lên
#   GitHub; bật GitHub Pages (hoặc nối repo với Vercel / Cloudflare Pages) để có link công khai.
#   Token: GitHub > Settings > Developer settings > Fine-grained token, chỉ repo đó, quyền Contents: Read and write.
PUBLIC_SINCE=
PUBLIC_GITHUB_REPO=
PUBLIC_GITHUB_BRANCH=main
PUBLIC_GITHUB_TOKEN=
PUBLIC_REPO_URL=
