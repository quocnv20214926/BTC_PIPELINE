POSTGRES_PASSWORD=replace-with-a-local-password
# Tối đa 28: Binance chỉ giữ ~30 ngày open interest / long-short ratio, nên lấy hết khi khởi tạo.
BACKFILL_DAYS=28
LOOKBACK=60
POLL_SECONDS=60


# Telegram bot gửi tín hiệu (tạo bot với @BotFather). Lấy chat id bằng:
#   docker compose run --rm telegram python -m pipeline telegram-setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TP được theo dõi để chấm kết quả: 1 (TP 1R) hoặc 2 (TP 2R)
TELEGRAM_TRACK_RR=1
# Phí + trượt giá khứ hồi (0.001 = 0.1%), dùng để tính R sau phí
TELEGRAM_FEE_PCT=0.001
# false = các lệnh độc lập (giống bộ thực thi); true = chỉ một lệnh tại một thời điểm
TELEGRAM_ONE_AT_A_TIME=false
TELEGRAM_UTC_OFFSET_HOURS=7
# Giờ gửi tổng kết hằng ngày (giờ địa phương), -1 để tắt
TELEGRAM_DAILY_HOUR=8

# Bộ thực thi (model-signals quyết định vào lệnh theo model_training/execution_m1.py)
# Độ confident = R kỳ vọng sau phí. abs: vào lệnh khi score > EXEC_MIN_SCORE.
# rolling: score trong top EXEC_TOP_FRAC của 60 ngày trước (đặt EXEC_MIN_SCORE=0 nếu dùng rolling).
EXEC_RR=1
EXEC_MODE=abs
EXEC_MIN_SCORE=0.05
EXEC_TOP_FRAC=0.02
EXEC_FEE_ROUNDTRIP=0.001

# Model v3 (sự kiện bất thường, TP = SL). Bundle tạo bởi model_training/trainv3.ipynb
MODEL_V3_BUNDLE=artifacts/5m_event_v3/model_v3.joblib
MODEL_V3_HISTORY_DAYS=20
# Để trống = dùng ngưỡng R kỳ vọng chọn khi train; đặt số (vd 0.05) để ghi đè
MODEL_V3_MIN_EV=
# Bot Telegram theo dõi tín hiệu của model v3
TELEGRAM_SOURCE=modelv3_event
TELEGRAM_HEALTH_SERVICE=model-signals-v3
